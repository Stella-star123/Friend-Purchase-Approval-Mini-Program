.tip-banner {
  margin: 24rpx 0 40rpx;
}

.placeholder,
.placeholder-text {
  color: var(--color-text-placeholder);
  font-size: 24rpx;
}

/* 价格输入：前置 ¥ */
.price-control {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: var(--color-bg-input);
  border-radius: var(--radius-input);
  box-sizing: border-box;
}

.price-control__prefix {
  flex: none;
  margin-right: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.price-control__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

/* 上传区 88 高 */
.upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 176rpx;
  background-color: var(--color-bg-input);
  border-radius: var(--radius-input);
  border: 2rpx dashed #d8dce3;
  box-sizing: border-box;
}

.upload__plus {
  font-size: 48rpx;
  line-height: 1;
  color: var(--color-text-placeholder);
}

.upload__text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

.upload-preview {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: var(--color-bg-input);
  border-radius: var(--radius-input);
}

.upload-preview__img {
  width: 136rpx;
  height: 136rpx;
  border-radius: 16rpx;
  background-color: #e3e6ea;
}

.upload-preview__info {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
}

.upload-preview__status {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.upload-preview__remove {
  font-size: 26rpx;
  color: var(--color-rejected);
}
