.back {
  width: 60rpx;
  font-size: 48rpx;
  line-height: 1;
  color: var(--color-text-primary);
}

.back--ghost {
  visibility: hidden;
}

/* 状态横幅 */
.status-banner {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-radius: var(--radius-card);
  margin-bottom: 32rpx;
}

.status-banner--pending {
  background-color: var(--color-pending-bg);
}

.status-banner--approved {
  background-color: var(--color-approved-bg);
}

.status-banner--rejected {
  background-color: var(--color-rejected-bg);
}

.status-banner__icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.status-banner__body {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.status-banner__title {
  font-size: 30rpx;
  font-weight: 600;
}

.status-banner--pending .status-banner__title {
  color: var(--color-pending);
}

.status-banner--approved .status-banner__title {
  color: var(--color-approved);
}

.status-banner--rejected .status-banner__title {
  color: var(--color-rejected);
}

.status-banner__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.detail-card {
  padding: 8rpx 32rpx;
}

/* 商品截图 88×88 圆角 8 */
.thumb-wrap {
  margin-top: 32rpx;
}

.thumb {
  width: 176rpx;
  height: 176rpx;
  border-radius: 16rpx;
  background-color: var(--color-bg-surface);
}

/* 审批备注框 */
.note {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: var(--radius-card);
}

.note--rejected {
  background-color: var(--color-rejected-bg);
}

.note--approved {
  background-color: var(--color-approved-bg);
}

.note__label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.note__text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text-primary);
}
