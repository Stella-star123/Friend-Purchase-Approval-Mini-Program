<view class="page">
  <view class="page-header">
    <text class="page-title">待我审批</text>
    <text
      class="page-header__action {{state === 'loading' ? 'page-header__action--disabled' : ''}}"
      bindtap="onRefreshTap"
    >刷新</text>
  </view>

  <skeleton wx:if="{{state === 'loading'}}" count="3" />

  <!-- 非审批人：403，不显示重试 -->
  <error-tip
    wx:elif="{{state === 'forbidden'}}"
    text="{{errorText}}"
    show-retry="{{false}}"
  />

  <error-tip wx:elif="{{state === 'error'}}" text="{{errorText}}" bind:retry="onRetry" />

  <empty-state wx:elif="{{state === 'empty'}}" text="当前没有待审批的申请" />

  <block wx:else>
    <!-- 汇总条 -->
    <view class="banner summary">共 {{total}} 笔待审批 · 合计 ¥{{sumPriceText}}</view>

    <view
      class="pending-card"
      wx:for="{{list}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goApprove"
      hover-class="pending-card--hover"
    >
      <view class="pending-card__row">
        <text class="pending-card__name">{{item.itemName}}</text>
        <text class="pending-card__price">¥{{item.priceText}}</text>
      </view>
      <view class="pending-card__row pending-card__row--sub">
        <text class="pending-card__meta">{{item.applicantMask}}</text>
        <text class="pending-card__link">去审批 ›</text>
      </view>
    </view>

    <view class="list-footer">仅展示金额 ¥5 及以上的待审申请</view>
  </block>

  <!-- 提醒开关（审批人可见） -->
  <view
    class="reminder"
    wx:if="{{state === 'ready' || state === 'empty'}}"
    bindtap="onEnableReminder"
  >
    <text class="reminder__text">{{subscribeReady ? '提醒已开启（一次性）' : '开启新申请微信提醒'}}</text>
    <text class="reminder__arrow">›</text>
  </view>
</view>
