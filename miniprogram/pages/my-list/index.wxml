<view class="page page--gap-bottom">
  <view class="page-header">
    <text class="page-title">我的申请</text>
    <text
      class="page-header__action {{state === 'loading' ? 'page-header__action--disabled' : ''}}"
      bindtap="onRefreshTap"
    >刷新</text>
  </view>

  <!-- 加载中 -->
  <skeleton wx:if="{{state === 'loading'}}" count="3" />

  <!-- 错误 -->
  <error-tip wx:elif="{{state === 'error'}}" text="{{errorText}}" bind:retry="onRetry" />

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{state === 'empty'}}"
    text="暂无申请记录"
    action-text="去提交申请"
    bind:action="goApply"
  />

  <!-- 列表 -->
  <block wx:else>
    <view
      class="apply-card"
      wx:for="{{list}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goDetail"
      hover-class="apply-card--hover"
    >
      <view class="apply-card__main">
        <text class="apply-card__name">{{item.itemName}}</text>
        <text class="apply-card__meta">{{item.createdAtShort}}</text>
        <text class="apply-card__price">¥{{item.priceText}}</text>
      </view>
      <view class="apply-card__side">
        <status-tag status="{{item.status}}" />
      </view>
    </view>

    <view class="list-footer">共 {{total}} 条申请</view>
  </block>

  <!-- 新建入口 -->
  <view class="footer-bar" wx:if="{{state !== 'empty'}}">
    <button class="btn btn--primary" bindtap="goApply">新建申请</button>
  </view>
</view>
