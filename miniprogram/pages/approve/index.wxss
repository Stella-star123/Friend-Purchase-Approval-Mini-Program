.back {
  width: 60rpx;
  font-size: 48rpx;
  line-height: 1;
  color: var(--color-text-primary);
}

.back--ghost {
  visibility: hidden;
}

/* 申请人条 64 高，头像圆 32 蓝底白字 */
.applicant {
  display: flex;
  align-items: center;
  height: 128rpx;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.applicant__avatar {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.applicant__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-left: 20rpx;
  min-width: 0;
}

.applicant__name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.applicant__openid {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.approve-card {
  padding: 8rpx 32rpx;
}

.thumb-wrap {
  margin-top: 32rpx;
}

.thumb {
  width: 176rpx;
  height: 176rpx;
  border-radius: 16rpx;
  background-color: var(--color-bg-surface);
}

.note-field {
  margin-top: 32rpx;
}

/* 审批备注框 72 高 圆角10 */
.field__control--note {
  height: 144rpx;
  padding: 24rpx;
  line-height: 1.6;
  width: 100%;
}

.placeholder {
  color: var(--color-text-placeholder);
  font-size: 24rpx;
}

.handled {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: var(--radius-card);
  background-color: var(--color-bg-surface);
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
