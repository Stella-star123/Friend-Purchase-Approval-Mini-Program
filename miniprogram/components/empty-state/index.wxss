.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0 80rpx;
}

/* 图标区 64×64 圆角 16，底色 #EDEFF3 */
.empty__icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background-color: #edeff3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty__icon-doc {
  width: 56rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.empty__icon-line {
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #c3c8d0;
}

.empty__icon-line--short {
  width: 60%;
}

.empty__text {
  margin-top: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #6b7280;
}

.empty__action {
  margin-top: 40rpx;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 48rpx;
  background-color: #3b6ff5;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
